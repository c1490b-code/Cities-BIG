rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isVerified() { return request.auth.token.email_verified == true; }

    // --- Entities ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
             data.keys().size() == 5 &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 200 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['official', 'citizen'] &&
             data.createdAt == request.time;
    }

    function isValidRegistry(data) {
      return data.keys().hasAll(['cityName', 'region', 'representativeUid', 'representativeName', 'representativeEmail', 'termsSigned', 'licenseSigned', 'contractSigned', 'leaseSigned', 'utilitySigned', 'timestamp', 'status']) &&
             data.representativeUid == request.auth.uid &&
             data.cityName is string && data.cityName.size() <= 100 &&
             data.region is string && data.region.size() <= 100 &&
             data.termsSigned == true &&
             data.licenseSigned == true &&
             data.contractSigned == true &&
             data.leaseSigned == true &&
             data.utilitySigned == true &&
             data.timestamp == request.time &&
             data.status == 'pending';
    }

    // --- Matches ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow create: if isOwner(userId) && isVerified() && isValidUser(incoming());
      allow update: if isOwner(userId) && isVerified() && isValidUser(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName']);
    }

    match /users/{userId}/private/{document=**} {
      allow read, write: if isOwner(userId);
    }

    match /registries/{registryId} {
      allow get: if isOwner(existing().representativeUid);
      allow list: if isSignedIn() && resource.data.representativeUid == request.auth.uid;
      allow create: if isSignedIn() && isVerified() && isValidId(registryId) && isValidRegistry(incoming());
      // Verification logic: System (client-simulated but logic-guarded) updates status to 'verified'
      // Strictly only allow specific field changes during 'verification'
      allow update: if isSignedIn() && isOwner(existing().representativeUid) &&
                    existing().status == 'pending' &&
                    incoming().status == 'verified' &&
                    incoming().presidentialSignature is string &&
                    incoming().presidentialSeal is string &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'presidentialSignature', 'presidentialSeal']);
    }
  }
}
